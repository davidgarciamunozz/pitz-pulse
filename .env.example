# Copy to .env for local development. Leave the key empty until configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
PROMPT_VERSION=v1
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_ATTEMPTS=3
MODEL_CONCURRENCY_LIMIT=3
MODEL_BACKOFF_BASE_SECONDS=0.5
MODEL_BACKOFF_MAX_SECONDS=8

# Set both input and output prices for the configured model when known.
# Leave all prices empty to report estimated cost as unknown.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
OPENAI_CACHED_INPUT_PRICE_PER_MILLION=
